<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>XCNN开发者平台 - 安卓版界面展示</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
            -webkit-tap-highlight-color: transparent; /* 移除安卓点击高亮 */
        }

        :root {
            --primary-color: #1890ff;
            --secondary-color: #e6f7ff;
            --text-color: #333;
            --text-secondary: #666;
            --text-light: #999;
            --bg-color: #f5f5f5;
            --card-bg: #ffffff;
            --border-color: #eee;
            --shadow-color: rgba(0,0,0,0.05);
            --success-color: #52c41a;
            --warning-color: #faad14;
            --error-color: #f5222d;
        }

        body {
            background-color: var(--bg-color);
            color: var(--text-color);
            font-size: 15px; /* 增大基础字体 */
            line-height: 1.6;
            -webkit-overflow-scrolling: touch; /* 优化滚动 */
        }

        .container {
            max-width: 100%;
            margin: 0 auto;
            padding: 15px;
        }

        .page-title {
            text-align: center;
            margin-bottom: 30px;
            color: var(--primary-color);
            font-size: 20px; /* 增大标题字体 */
            padding: 10px 0;
        }

        .page-section {
            margin-bottom: 40px;
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 2px 10px var(--shadow-color);
            overflow: hidden;
        }

        .section-header {
            background-color: var(--primary-color);
            color: white;
            padding: 15px 20px;
            font-size: 18px;
            font-weight: bold;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .section-content {
            padding: 15px;
        }

        .divider {
            height: 1px;
            background-color: var(--border-color);
            margin: 25px 0;
        }

        /* 状态栏 */
        .status-bar {
            background-color: var(--primary-color);
            color: white;
            height: 28px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 15px;
            font-size: 12px;
        }

        /* 头部导航 */
        .header {
            background-color: var(--primary-color);
            color: white;
            height: 56px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 0 15px;
            position: relative;
        }

        .header .title {
            font-size: 18px;
            font-weight: bold;
            flex: 1;
            text-align: center;
        }

        .header .back-icon {
            font-size: 22px; /* 增大图标 */
            width: 44px; /* 增大触控区域 */
            height: 44px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        .header .action-icon {
            font-size: 22px; /* 增大图标 */
            width: 44px; /* 增大触控区域 */
            height: 44px;
            display: flex;
            justify-content: center;
            align-items: center;
        }

        /* 底部导航 */
        .bottom-nav {
            height: 65px; /* 增加高度 */
            background-color: white;
            display: flex;
            justify-content: space-around;
            align-items: center;
            box-shadow: 0 -2px 10px var(--shadow-color);
            border-top: 1px solid var(--border-color);
        }

        .bottom-nav .nav-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            flex: 1;
            height: 100%;
            color: var(--text-light);
            font-size: 13px; /* 调整字体 */
            padding: 5px 0; /* 增加垂直内边距 */
        }

        .bottom-nav .nav-item.active {
            color: var(--primary-color);
        }

        .bottom-nav .nav-item .icon {
            font-size: 26px; /* 增大图标 */
            margin-bottom: 5px;
        }

        /* 卡片样式 */
        .card {
            background-color: var(--card-bg);
            border-radius: 12px;
            box-shadow: 0 2px 8px var(--shadow-color);
            margin: 16px 0;
            overflow: hidden;
        }

        .card-title {
            font-size: 17px; /* 增大字体 */
            font-weight: bold;
            padding: 18px; /* 增大内边距 */
            border-bottom: 1px solid var(--border-color);
        }

        .card-content {
            padding: 18px; /* 增大内边距 */
        }

        /* 按钮样式 */
        .btn {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 8px;
            padding: 12px 20px; /* 增大内边距 */
            font-size: 15px; /* 增大字体 */
            min-height: 44px; /* 最小高度 */
            display: inline-flex; /* 垂直居中 */
            align-items: center;
            justify-content: center;
        }

        .btn.secondary {
            background-color: white;
            color: var(--primary-color);
            border: 1px solid var(--primary-color);
        }

        .btn-container {
            display: flex;
            gap: 12px;
            margin-top: 20px;
        }

        /* 标签页样式 */
        .tabs {
            display: flex;
            background-color: white;
            border-bottom: 1px solid var(--border-color);
            overflow-x: auto;
            -webkit-overflow-scrolling: touch; /* 优化滚动 */
        }

        .tab {
            padding: 18px; /* 增大内边距 */
            font-size: 15px; /* 增大字体 */
            color: var(--text-secondary);
            position: relative;
            flex-shrink: 0;
            white-space: nowrap;
        }

        .tab.active {
            color: var(--primary-color);
            font-weight: bold;
        }

        .tab.active::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 18px;
            right: 18px;
            height: 3px; /* 加粗下划线 */
            background-color: var(--primary-color);
        }

        /* 标签样式 */
        .tag {
            display: inline-block;
            background-color: var(--secondary-color);
            color: var(--primary-color);
            padding: 5px 10px; /* 增大内边距 */
            border-radius: 4px;
            font-size: 13px; /* 调整字体 */
            margin-right: 8px;
            margin-bottom: 8px;
        }

        /* 首页样式 */
        .home-container {
            padding: 16px;
        }

        .home-card {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px var(--shadow-color);
            margin-bottom: 20px;
            overflow: hidden;
        }

        .home-card-header {
            padding: 18px; /* 增大内边距 */
        }

        .home-card-title {
            font-size: 19px; /* 增大字体 */
            font-weight: bold;
            margin-bottom: 4px;
        }

        .home-card-subtitle {
            font-size: 15px; /* 增大字体 */
            color: var(--text-secondary);
        }

        .home-card-content {
            padding: 18px; /* 增大内边距 */
        }

        .home-card-stats {
            display: flex;
            margin-bottom: 16px;
            justify-content: center;
        }

        .home-card-stat {
            flex: 1;
            text-align: center;
        }

        .home-card-stat-value {
            font-size: 26px; /* 增大字体 */
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 4px;
        }

        .home-card-stat-label {
            font-size: 13px; /* 调整字体 */
            color: var(--text-secondary);
        }

        .home-card-info {
            font-size: 15px; /* 增大字体 */
            color: var(--text-secondary);
            line-height: 1.6;
            margin-bottom: 12px;
        }

        .home-card-tags {
            margin-bottom: 16px;
        }

        .home-card-footer {
            display: flex;
            justify-content: flex-end;
            padding: 14px 18px; /* 调整内边距 */
            border-top: 1px solid var(--border-color);
        }

        /* 模型市场样式 */
        .model-categories {
            display: flex;
            overflow-x: auto;
            background-color: white;
            padding: 14px 18px; /* 调整内边距 */
            border-bottom: 1px solid var(--border-color);
            -webkit-overflow-scrolling: touch; /* 优化滚动 */
        }

        .model-category {
            font-size: 15px; /* 增大字体 */
            color: var(--text-secondary);
            padding: 10px 18px; /* 增大内边距 */
            border-radius: 18px;
            margin-right: 12px;
            white-space: nowrap;
        }

        .model-category.active {
            background-color: var(--secondary-color);
            color: var(--primary-color);
            font-weight: bold;
        }

        .model-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 16px;
            padding: 16px;
        }

        .model-card {
            background-color: white;
            border-radius: 12px;
            box-shadow: 0 2px 8px var(--shadow-color);
            overflow: hidden;
            padding: 18px; /* 增大内边距 */
        }

        .model-card-image {
            height: 140px;
            background-color: var(--secondary-color);
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 48px;
            border-radius: 8px;
            margin-bottom: 16px;
        }

        .model-card-title {
            font-size: 17px; /* 增大字体 */
            font-weight: bold;
            margin-bottom: 8px;
        }

        .model-card-desc {
            font-size: 15px; /* 增大字体 */
            color: var(--text-secondary);
            margin-bottom: 12px;
            line-height: 1.5;
        }

        .model-card-info {
            display: flex;
            justify-content: space-between;
            font-size: 13px; /* 调整字体 */
            color: var(--text-light);
        }

        /* 模型详情页样式 */
        .model-detail-header {
            height: 200px;
            background-color: #000;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            font-size: 24px;
        }

        .model-detail-content {
            padding: 20px;
        }

        .model-detail-title {
            font-size: 22px; /* 增大字体 */
            font-weight: bold;
            margin-bottom: 12px;
        }

        .model-detail-tags {
            margin-bottom: 20px;
        }

        .model-detail-section {
            margin-bottom: 24px;
        }

        .model-detail-section-title {
            font-size: 17px; /* 增大字体 */
            font-weight: bold;
            margin-bottom: 12px;
        }

        .model-detail-metrics {
            display: flex;
            flex-wrap: wrap; /* 允许换行 */
            margin-bottom: 16px;
            gap: 10px; /* 添加间距 */
        }

        .model-detail-metric {
            flex: 1;
            min-width: calc(33% - 10px); /* 确保至少三个一行 */
            text-align: center;
            padding: 14px; /* 调整内边距 */
            border-radius: 8px;
            background-color: var(--secondary-color);
        }

        .model-detail-metric-value {
            font-size: 22px; /* 增大字体 */
            font-weight: bold;
            color: var(--primary-color);
            margin-bottom: 4px;
        }

        .model-detail-metric-label {
            font-size: 13px; /* 调整字体 */
            color: var(--text-secondary);
        }

        /* 测试页面样式 */
        .test-container {
            display: flex;
            flex-direction: column;
        }

        .test-preview {
            flex: 1;
            background-color: #000;
            position: relative;
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            min-height: 300px;
        }

        .test-controls {
            background-color: white;
            padding: 18px; /* 增大内边距 */
        }

        .test-section {
            margin-bottom: 24px;
        }

        .test-section-title {
            font-size: 17px; /* 增大字体 */
            font-weight: bold;
            margin-bottom: 16px;
        }

        .test-status {
            display: flex;
            align-items: center;
            padding: 14px; /* 增大内边距 */
            border-radius: 8px;
            margin-bottom: 12px;
        }

        .test-status-icon {
            font-size: 22px; /* 增大图标 */
            margin-right: 12px;
        }

        .test-status.success {
            background-color: rgba(82, 196, 26, 0.1);
            color: var(--success-color);
        }

        .test-status.warning {
            background-color: rgba(250, 173, 20, 0.1);
            color: var(--warning-color);
        }

        .test-status.info {
            background-color: rgba(24, 144, 255, 0.1);
            color: var(--primary-color);
        }

        /* 训练管理页样式 */
        .training-options {
            display: flex;
            flex-direction: column;
            gap: 16px;
            margin-bottom: 24px;
        }

        .training-option {
            background-color: var(--secondary-color);
            border-radius: 12px;
            padding: 18px; /* 增大内边距 */
            display: flex;
            flex-direction: column;
            align-items: center;
            text-align: center;
        }

        .training-option-icon {
            font-size: 40px; /* 增大图标 */
            margin-bottom: 12px;
            color: var(--primary-color);
        }

        .training-option-title {
            font-size: 17px; /* 增大字体 */
            font-weight: bold;
            margin-bottom: 8px;
        }

        .training-option-desc {
            font-size: 15px; /* 增大字体 */
            color: var(--text-secondary);
            margin-bottom: 16px;
        }

        /* 大模型对话页样式 */
        .chat-container {
            display: flex;
            flex-direction: column;
        }

        .chat-sidebar {
            width: 100%;
            background-color: white;
            border-right: 1px solid var(--border-color);
            overflow-y: auto;
            padding: 18px; /* 增大内边距 */
        }

        .chat-history-item {
            padding: 14px; /* 增大内边距 */
            border-bottom: 1px solid var(--border-color);
        }

        .chat-history-time {
            font-size: 13px; /* 调整字体 */
            color: var(--text-light);
        }

        .chat-history-title {
            font-size: 15px; /* 增大字体 */
            margin-top: 4px;
        }

        .chat-main {
            flex: 1;
            display: flex;
            flex-direction: column;
            background-color: var(--bg-color);
        }

        .chat-header {
            padding: 18px; /* 增大内边距 */
            background-color: white;
            border-bottom: 1px solid var(--border-color);
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .chat-model-info {
            font-size: 15px; /* 增大字体 */
            font-weight: bold;
        }

        .chat-messages {
            flex: 1;
            padding: 18px; /* 增大内边距 */
            overflow-y: auto;
            min-height: 300px;
            -webkit-overflow-scrolling: touch; /* 优化滚动 */
        }

        .chat-message {
            margin-bottom: 18px; /* 增大间距 */
            max-width: 85%; /* 调整宽度 */
        }

        .chat-message.user {
            margin-left: auto;
        }

        .chat-message.bot {
            margin-right: auto;
        }

        .chat-message-content {
            padding: 14px; /* 增大内边距 */
            border-radius: 14px;
            font-size: 15px; /* 增大字体 */
            line-height: 1.6;
        }

        .chat-message.user .chat-message-content {
            background-color: var(--primary-color);
            color: white;
            border-top-right-radius: 0;
        }

        .chat-message.bot .chat-message-content {
            background-color: white;
            border-top-left-radius: 0;
        }

        .chat-message-time {
            font-size: 13px; /* 调整字体 */
            color: var(--text-light);
            margin-top: 5px;
            text-align: right;
        }

        .chat-input {
            padding: 18px; /* 增大内边距 */
            background-color: white;
            border-top: 1px solid var(--border-color);
            display: flex;
            align-items: center;
        }

        .chat-input input {
            flex: 1;
            padding: 14px; /* 增大内边距 */
            border: 1px solid var(--border-color);
            border-radius: 24px;
            font-size: 15px; /* 增大字体 */
            margin-right: 12px;
            min-height: 44px; /* 最小高度 */
        }

        .chat-input button {
            background-color: var(--primary-color);
            color: white;
            border: none;
            border-radius: 50%;
            width: 44px; /* 增大按钮 */
            height: 44px;
            display: flex;
            justify-content: center;
            align-items: center;
            font-size: 20px; /* 增大图标 */
        }

        /* 反馈页面样式 */
        .feedback-container {
            padding: 16px;
        }

        .feedback-table-container {
            overflow-x: auto; /* 允许表格水平滚动 */
            -webkit-overflow-scrolling: touch; /* 优化滚动 */
            margin-bottom: 20px;
            background-color: white;
            border-radius: 8px;
        }

        .feedback-table {
            width: 100%;
            min-width: 600px; /* 确保表格内容不换行 */
            border-collapse: collapse;
        }

        .feedback-table th,
        .feedback-table td {
            border: 1px solid var(--border-color);
            padding: 14px; /* 增大内边距 */
            text-align: left;
            white-space: nowrap; /* 防止换行 */
        }

        .feedback-table th {
            background-color: var(--secondary-color);
            font-weight: bold;
        }

        .feedback-table tr:nth-child(even) {
            background-color: var(--bg-color);
        }

        .feedback-chart {
            background-color: var(--secondary-color);
            height: 200px;
            border-radius: 8px;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--text-secondary);
        }

        /* 通用工具类 */
        .mt-16 {
            margin-top: 16px;
        }

        .mb-16 {
            margin-bottom: 16px;
        }

        .text-center {
            text-align: center;
        }

        /* 列表样式优化 */
        ul, ol {
            padding-left: 20px;
            margin-bottom: 15px;
        }

        li {
            margin-bottom: 8px;
        }

        /* 段落间距 */
        p {
            margin-bottom: 12px;
        }
    </style>
</head>
<body>
    <div class="container">
        <h1 class="page-title">XCNN开发者平台 - 安卓版界面展示</h1>

        <!-- 首页 -->
        <div class="page-section">
            <div class="section-header">
                <span>首页</span>
            </div>
            <div class="section-content">
                <!-- 状态栏 -->
                <div class="status-bar">
                    <div>17:21</div>
                    <div>
                        <span>📶</span>
                        <span>🔋</span>
                        <span>⚙️</span>
                    </div>
                </div>

                <!-- 头部导航 -->
                <div class="header">
                    <div class="back-icon" style="visibility: hidden;">◀</div>
                    <div class="title">XCNN开发者平台</div>
                    <div class="action-icon">💬</div>
                </div>

                <!-- 首页内容 -->
                <div class="home-container">
                    <div class="home-card">
                        <div class="home-card-header">
                            <div class="home-card-title">模型市场</div>
                            <div class="home-card-subtitle">浏览和使用优化的AI模型</div>
                        </div>
                        <div class="home-card-content">
                            <div class="home-card-stats">
